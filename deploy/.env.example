# Copy to deploy/.env and change every value. deploy/.env is git-ignored.
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root
JWT_SECRET=change-me-to-64-or-more-random-characters-0123456789abcdefghijklmnopqrstuv
GRAFANA_PASSWORD=change-me-grafana
# Optional: Stripe test mode keys (sk_test_..., pk_test_...)
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
# Reconciler: 15 minutes grace; every 30 s for the live demo (production default 5 minutes)
RECONCILE_GRACE_MINUTES=15
RECONCILE_DELAY_MS=30000

# Ports (change if taken on your machine)
API_PORT=8080
ADMIN_PORT=4200
STOREFRONT_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
MAILPIT_PORT=8025
ALERTMANAGER_PORT=9093
# MONEYORDER or STRIPE (needs STRIPE_TEST_PUBLISHABLE_KEY)
STOREFRONT_PAYMENT_TYPE=MONEYORDER
# Logs: json (one object per line, with requestId) or text
LOG_FORMAT=json
# Backups: every 6 hours, retry after 5 minutes when a dump fails its checks
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETRY_SECONDS=300

# Only for a second stack on the same machine (CI, rehearsal): pick another subnet and
# image tag so it does not clash with the first, and run compose with -p <other-name>.
# Give it its own dump directory too (relative to deploy/), e.g. ./backup/dumps/<other-name>:
# otherwise each stack's retention deletes the other's dumps and the restore drill may
# compare one stack's dump with the other stack's database.
BACKEND_SUBNET=172.28.0.0/16
IMAGE_TAG=local
BACKUP_DUMPS_DIR=./backup/dumps

# AES-256-GCM key for stored payment and shipping credentials: openssl rand -base64 32
SHOPIZER_ENCRYPTION_KEY=change-me-run-openssl-rand-base64-32
# Only for databases created before v2 encryption (the old shared demo key was 7070200000000007)
SHOPIZER_LEGACY_SECRET_KEY=
