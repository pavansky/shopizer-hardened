# Copy to deploy/.env and change every value. deploy/.env is git-ignored.
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root
JWT_SECRET=change-me-to-64-or-more-random-characters-0123456789abcdefghijklmnopqrstuv
GRAFANA_PASSWORD=change-me-grafana
# Optional: Stripe test mode keys (sk_test_..., pk_test_...)
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
# Reconciler: 15 minutes grace; every 30 s for the live demo (production default 5 minutes)
RECONCILE_GRACE_MINUTES=15
RECONCILE_DELAY_MS=30000

# Ports (change if taken on your machine)
API_PORT=8080
ADMIN_PORT=4200
STOREFRONT_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
# MONEYORDER or STRIPE (needs STRIPE_TEST_PUBLISHABLE_KEY)
STOREFRONT_PAYMENT_TYPE=MONEYORDER
